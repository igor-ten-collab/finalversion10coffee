# Fill the generated PostgreSQL internal URL and secret in Coolify, never in Git.
DATABASE_URL=
DATABASE_SSL=false
PAYLOAD_SECRET=
PAYLOAD_DB_PUSH=false
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_SERVER_URL=https://10coffee.ru
NEXT_PUBLIC_SITE_URL=https://10coffee.ru
SHOP_SITE_URL=https://shop.10coffee.ru/main
AUTH_COOKIE_SECURE=true
SHOP_RESTRICT_ACCESS=false
SHOP_ALLOWED_IPS=

# Keep external jobs disabled until restored data and numbering are reconciled.
MOYSKLAD_ENABLED=false
MOYSKLAD_SYNC_ORDERS_ON_CREATE=false
YOOKASSA_ENABLED=false
YANDEX_DELIVERY_ENV=test
# Also disable payment_settings.enabled in the restored database; DB overrides env.
CRON_SECRET=

# Local uploads use persistent mounts. Do not set S3_BUCKET without checking it.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Re-enter required integration credentials privately in Coolify after recovery.
SMTP_EMAIL=
SMTP_PASSWORD=
DADATA_API_KEY=
TELEGRAM_BOT_TOKEN=
VK_COMMUNITY_ACCESS_TOKEN=
