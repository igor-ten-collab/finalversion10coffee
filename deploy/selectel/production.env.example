# Полный справочник переменных текущего кода, проверен 2026-11-04.
# Это НЕ экспорт утраченного Coolify: прежние боевые значения неизвестны.
# НЕ заменяйте рабочие переменные целиком этим шаблоном: пустые значения
# предназначены для заполнения, существующие DATABASE_URL/PAYLOAD_SECRET сохранить.
# В Coolify -> 10coffee -> Environment Variables -> Production -> Normal
# добавляйте/изменяйте нужные параметры по одному. Неиспользуемые блоки пропустить.
# Все параметры доступны при работе приложения (Runtime).
# Build + Runtime: DATABASE_URL, PAYLOAD_SECRET, NEXT_PUBLIC_*, S3_ENDPOINT.
# Остальные интеграционные секреты: только Runtime.
# Для паролей/ключей включить Literal, чтобы символы $ не интерполировались.
# Источник и назначение каждого блока указаны ниже. Значения без ключей —
# настройки для восстановления или значения по умолчанию, НЕ прежние боевые.

# БАЗА И ПРИЛОЖЕНИЕ: payload.config.ts:41, lib/db.ts:8, package.json.
# DATABASE_URL: уже работающий Postgres URL (internal) новой базы в Coolify.
# PAYLOAD_SECRET: сохранить текущее рабочее значение, не менять при переносе списка.
DATABASE_URL=
DATABASE_SSL=false
PAYLOAD_SECRET=
PAYLOAD_DB_PUSH=false
# PORT/NODE_ENV — параметры Next.js; HOSTNAME — параметр контейнера.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# Node 22 выбран через engines в package.json. Railpack не требует NIXPACKS_NODE_VERSION.

# АДРЕСА И ДОСТУП: payload.config.ts:73, lib/auth/local.ts:50,
# lib/actions/auth.ts:72, middleware.ts:29, next.config.ts:20.
# Первые два URL — основной сайт, SHOP_SITE_URL — розничный личный кабинет.
NEXT_PUBLIC_SERVER_URL=https://10coffee.ru
NEXT_PUBLIC_SITE_URL=https://10coffee.ru
SHOP_SITE_URL=https://shop.10coffee.ru/main
AUTH_COOKIE_SECURE=true
SHOP_RESTRICT_ACCESS=false
# Список публичных IP через запятую; используется только при SHOP_RESTRICT_ACCESS=true.
SHOP_ALLOWED_IPS=

# ПОЧТА: общая настройка lib/email/smtp.ts для всех отправителей сайта и Payload.
# Сначала подтвердить домен в почтовом сервисе Selectel и настроить DKIM/SPF/DMARC.
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1127
SMTP_SECURE=true
# Числовой Login из почтового сервиса Selectel; это не email отправителя.
SMTP_USER=
# Адрес на подтверждённом домене, например noreply@10coffee.ru.
SMTP_EMAIL=
# Pass (API-key) из почтового сервиса Selectel; не пароль Gmail и не DNS-key.
SMTP_PASSWORD=

# DADATA: lib/dadata-address.ts:48, app/api/dadata/route.ts:11.
# Токен из кабинета DaData. Непустое значение найдено локально; работу API не проверяли.
DADATA_API_KEY=

# КАРТЫ: components/landing/MapModal.tsx:130,
# components/shop/cdek-pickup-map.tsx:94. Оба ключа публичные (Build + Runtime).
# NEXT_PUBLIC_YANDEX_MAPS_KEY — карта на основном сайте.
# NEXT_PUBLIC_CDEK_MAP_API_KEY — карта выбора ПВЗ СДЭК в рознице.
NEXT_PUBLIC_YANDEX_MAPS_KEY=
NEXT_PUBLIC_CDEK_MAP_API_KEY=

# СДЭК: lib/cdek.ts:1, app/api/cdek/widget/route.ts:4.
# ID/secret из кабинета СДЭК API. URL ниже — default кода.
# CDEK_SENDER_CITY_CODE=437 — Сочи, Краснодарский край: город указан пользователем,
# код подтверждён 2026-11-04 через /api/cdek/cities?q=Сочи на работающем сайте.
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_SENDER_CITY_CODE=437

# ЯНДЕКС ДОСТАВКА: lib/yandex-delivery.ts:64.
# Сейчас test; production выбирается после заполнения боевых реквизитов.
YANDEX_DELIVERY_ENV=test
# Тестовый API-токен из официальной документации. Без него test API не работает.
YANDEX_DELIVERY_TEST_API_TOKEN=
# Пустое значение использует тестовую станцию, заданную в коде.
YANDEX_DELIVERY_TEST_SOURCE_STATION_ID=
# Боевые реквизиты из кабинета Яндекс Доставки, игнорируются в режиме test.
YANDEX_DELIVERY_API_TOKEN=
YANDEX_DELIVERY_SOURCE_STATION_ID=
# Необязательный merchantId — только если выдан сервисом; ИНН отправителя.
YANDEX_DELIVERY_MERCHANT_ID=
YANDEX_DELIVERY_SENDER_INN=
# Необязательные запасные габариты/вес. Пусто = defaults текущего режима в коде.
# При test: 30/20/15 см, тара 100 г, товар 100 г.
# При production: 45/30/20 см, тара 100 г, товар 1000 г.
# Фактические габариты/вес варианта товара имеют приоритет над запасными.
YANDEX_DELIVERY_PACKAGE_LENGTH_CM=
YANDEX_DELIVERY_PACKAGE_WIDTH_CM=
YANDEX_DELIVERY_PACKAGE_HEIGHT_CM=
YANDEX_DELIVERY_PACKAGE_TARE_GRAMS=
YANDEX_DELIVERY_DEFAULT_ITEM_WEIGHT_GRAMS=

# ХРАНИЛИЩЕ: payload.config.ts:161, app/api/upload-avatar/route.ts:5.
# Полный набор выдаётся при создании S3-совместимого бакета и ключа доступа.
# Пока бакет не настроен, S3_BUCKET оставить пустым (Payload S3 отключён).
# Аватары обращаются в S3 напрямую и требуют действующие реквизиты.
# S3_ENDPOINT нужен и при Build: next.config.ts включает хост в список изображений.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# СОЦИАЛЬНЫЕ ВХОДЫ: lib/auth/social.ts:28.
# Пары client ID/secret из соответствующих OAuth-приложений.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
# В текущей реализации обмен VK не требует client secret; можно не задавать.
VK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# УВЕДОМЛЕНИЯ ЛОЯЛЬНОСТИ: lib/loyalty.ts:89.
# Telegram BotFather / токен сообщества VK с доступом к сообщениям.
TELEGRAM_BOT_TOKEN=
VK_COMMUNITY_ACCESS_TOKEN=
VK_API_VERSION=5.199

# ЮKASSA: lib/payments/yookassa.ts:17, payload/globals/PaymentSettings.ts:5.
# Настройки «Онлайн-оплата» в админке имеют приоритет над этими переменными.
# В восстановленной БД онлайн-оплата отключена; YOOKASSA_ENABLED=true
# само по себе НЕ включит её, пока enabled=false сохранено в админке.
# shopId и секрет — из кабинета ЮKassa, в локальной копии их нет.
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://shop.10coffee.ru/order/success
YOOKASSA_WEBHOOK_URL=https://shop.10coffee.ru/api/shop/payments/yookassa/webhook
# Этот же URL сохранить в ЮKassa -> HTTP-уведомления и включить
# payment.succeeded + payment.canceled. Переменная сама подписку не создаёт.
# npm start дополнительно сверяет платежи: первый запуск через 15 секунд,
# последующие через минуту после завершения. CRON_SECRET для этого не нужен.
# true по умолчанию; false явно отключает резервную сверку.
YOOKASSA_PAYMENT_RECONCILIATION_ENABLED=true

# ВНЕШНИЕ CRON-ЗАПРОСЫ: app/api/cron/*/route.ts.
# Секрет для Authorization: Bearer ...; найденное локальное значение можно перенести.
# Встроенный планировщик статусов МойСклад этот секрет не использует.
CRON_SECRET=

# МОЙСКЛАД: lib/moysklad/config.ts:74.
# Восстановление: false до ввода реквизитов и сверки данных/нумерации.
# Для включения синхронизации установить MOYSKLAD_ENABLED=true.
# Для отправки новых заказов также MOYSKLAD_SYNC_ORDERS_ON_CREATE=true.
# Автоимпорт статусов запускается через npm start (scripts/start-with-status-sync.mjs).
MOYSKLAD_ENABLED=false
MOYSKLAD_SYNC_ORDERS_ON_CREATE=false
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
# Использовать токен ИЛИ пару логин/пароль. При непустом токене приоритет у токена.
MOYSKLAD_TOKEN=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
# Общая организация обязательна для режима без канальных переопределений.
# ID организации, склада, услуги доставки, статуса и каналов берутся из МойСклад.
# Эти три ID подтверждены выводом API пользователя 2026-11-04:
# ООО «ПЕЙДЖ КОФЕ», «Склад готовой продукции», «[Служебная] Доставка сайта 10coffee».
MOYSKLAD_ORGANIZATION_ID=b58396fd-4a20-11f1-0a80-1649001319a0
MOYSKLAD_STORE_ID=85779621-4b24-11f1-0a80-04230029a15c
MOYSKLAD_DELIVERY_SERVICE_ID=85da36ff-4ded-11f1-0a80-00d400bdfef0
MOYSKLAD_ORDER_STATE_NEW_ID=
MOYSKLAD_SALES_CHANNEL_ID=ac5cebf5-4fa7-11f1-0a80-19e10023423c
# Пустое имя = название по умолчанию для текущего канала, указанное ниже.
MOYSKLAD_SALES_CHANNEL_NAME=
# Пустой тип = DIRECT_SALES для опта, ECOMMERCE для розницы/общего режима.
MOYSKLAD_SALES_CHANNEL_TYPE=
MOYSKLAD_PROJECT_ID=
MOYSKLAD_CONTRACT_ID=
MOYSKLAD_CREATE_INVOICE_ON_ORDER=true
MOYSKLAD_CREATE_COUNTERPARTIES=true
MOYSKLAD_CREATE_SALES_CHANNEL=true
MOYSKLAD_VAT_ENABLED=true
MOYSKLAD_VAT_INCLUDED=true
# Значение по умолчанию в коде, НЕ подтверждённая ставка организации.
MOYSKLAD_DEFAULT_VAT=0

# ПЕРЕОПРЕДЕЛЕНИЯ МОЙСКЛАД ДЛЯ ОПТА.
# Необязательные пустые ID используют соответствующие общие значения выше.
MOYSKLAD_WHOLESALE_ORGANIZATION_ID=
MOYSKLAD_WHOLESALE_STORE_ID=
MOYSKLAD_WHOLESALE_DELIVERY_SERVICE_ID=
MOYSKLAD_WHOLESALE_ORDER_STATE_NEW_ID=
MOYSKLAD_WHOLESALE_SALES_CHANNEL_ID=c1663497-962e-11f1-0a80-10380021c0a8
MOYSKLAD_WHOLESALE_SALES_CHANNEL_NAME=Сайт 10coffee — опт
MOYSKLAD_WHOLESALE_SALES_CHANNEL_TYPE=DIRECT_SALES
MOYSKLAD_WHOLESALE_PROJECT_ID=
MOYSKLAD_WHOLESALE_CONTRACT_ID=
MOYSKLAD_WHOLESALE_CREATE_INVOICE_ON_ORDER=true

# ПЕРЕОПРЕДЕЛЕНИЯ МОЙСКЛАД ДЛЯ РОЗНИЦЫ.
MOYSKLAD_RETAIL_ORGANIZATION_ID=
MOYSKLAD_RETAIL_STORE_ID=
MOYSKLAD_RETAIL_DELIVERY_SERVICE_ID=
MOYSKLAD_RETAIL_ORDER_STATE_NEW_ID=
MOYSKLAD_RETAIL_SALES_CHANNEL_ID=f2cf16d1-9628-11f1-0a80-1038001fa5e7
MOYSKLAD_RETAIL_SALES_CHANNEL_NAME=Сайт 10coffee — розница
MOYSKLAD_RETAIL_SALES_CHANNEL_TYPE=ECOMMERCE
MOYSKLAD_RETAIL_PROJECT_ID=
MOYSKLAD_RETAIL_CONTRACT_ID=
# false — значение по умолчанию; отдельный розничный счёт не создаётся.
MOYSKLAD_RETAIL_CREATE_INVOICE_ON_ORDER=false

# АВТОМАТИЧЕСКИЕ/НЕИСПОЛЬЗУЕМЫЕ ПАРАМЕТРЫ (вручную не добавлять):
# COOLIFY_URL приходит из Coolify; при рабочих NEXT_PUBLIC_* отдельно не требуется.
# PAYLOAD_MIGRATING задаётся служебной командой миграций, не постоянно в production.
# SHOP_PREVIEW_ENABLED и SBER_ACQUIRING_ENABLED из .env.local текущий код не читает.
# MOYSKLAD_AUTH_MODE текущий код не читает.
