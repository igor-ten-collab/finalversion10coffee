# МойСклад: восстановление подключения на Selectel, 2026-11-04.
# ID взяты из предоставленного пользователем вывода GET API: HTTP 200 для
# organization, store, service, saleschannel. Секретов в этом файле нет.
# ООО «ПЕЙДЖ КОФЕ» и «Склад готовой продукции» соответствуют ранее показанному
# пользователем розничному заказу 10C-00522. Для иной схемы опта проверить организацию.
# Добавлять/менять параметры по одному в Coolify -> 10coffee ->
# Environment Variables -> Production -> Normal. Для всех включить Runtime.
# Существующие MOYSKLAD_TOKEN либо MOYSKLAD_LOGIN/MOYSKLAD_PASSWORD сохранить.
# Не заменять этим дополнением всё содержимое Developer view.

# Этап 1: включить импорт статусов, автоматическую отправку новых заказов пока не включать.
MOYSKLAD_ENABLED=true
MOYSKLAD_SYNC_ORDERS_ON_CREATE=false

# Общие настройки; канальные переопределения организации/склада имеют приоритет.
MOYSKLAD_ORGANIZATION_ID=b58396fd-4a20-11f1-0a80-1649001319a0
MOYSKLAD_STORE_ID=85779621-4b24-11f1-0a80-04230029a15c
MOYSKLAD_DELIVERY_SERVICE_ID=85da36ff-4ded-11f1-0a80-00d400bdfef0

# Использовать существующие каналы продаж, не создавать замену.
MOYSKLAD_SALES_CHANNEL_ID=ac5cebf5-4fa7-11f1-0a80-19e10023423c
MOYSKLAD_WHOLESALE_SALES_CHANNEL_ID=c1663497-962e-11f1-0a80-10380021c0a8
MOYSKLAD_RETAIL_SALES_CHANNEL_ID=f2cf16d1-9628-11f1-0a80-1038001fa5e7

# Политика счетов из текущего кода: счёт для опта, без отдельного счёта для розницы.
MOYSKLAD_WHOLESALE_CREATE_INVOICE_ON_ORDER=true
MOYSKLAD_RETAIL_CREATE_INVOICE_ON_ORDER=false

# Start command: npm start. Он запускает сайт и планировщик статусов.
# После Deploy проверить Runtime Logs: enabled -> starting status import -> результат.
# До включения MOYSKLAD_SYNC_ORDERS_ON_CREATE=true сверить order_number_seq
# с текущими номерами заказов в МойСклад: восстановленная БД была старой.
# Затем проверить выгрузку одного нового заказа и обратное обновление его статуса.
